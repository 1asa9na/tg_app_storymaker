# Файл окружения на сервере: /opt/storymaker/<staging|production>.env, права 600.
# Значения без кавычек и без комментариев в той же строке.

# staging или production — должно совпадать с именем файла
APP_ENV=staging
# Домен окружения; DNS A-запись должна смотреть на сервер
APP_DOMAIN=staging.example.ru
IMAGE_REPO=ghcr.io/1asa9na/tg_app_storymaker

# openssl rand -hex 24
POSTGRES_PASSWORD=

# Токен бота окружения от @BotFather
BOT_TOKEN=
# openssl rand -hex 32
BOT_WEBHOOK_SECRET=

# Необязательно: ошибки API и плеера
SENTRY_DSN=
PLAYER_SENTRY_DSN=

# Supabase Storage: Storage → Settings → S3 Connection
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
