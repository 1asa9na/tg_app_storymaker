# Локальная разработка: cp .env.example .env
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://storymaker:storymaker@localhost:5432/storymaker
# Токен отдельного dev-бота от @BotFather (не прод и не стейджинг)
BOT_TOKEN=
# Вебхук нужен только на сервере; локально бот работает через python -m storymaker_api.polling
PUBLIC_URL=
BOT_WEBHOOK_SECRET=
SENTRY_DSN=
# Собранные тайтлы: uv run python -m storymaker_api.game build ../../content/titles --out build/titles
TITLES_DIR=build/titles
# Supabase Storage (S3): Storage → Settings → S3 Connection
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
